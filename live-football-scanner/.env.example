# Copia questo file in .env e inserisci le tue chiavi. Il file .env NON va mai committato.

# --- API-Football (obbligatoria): https://dashboard.api-football.com ---------------------
API_FOOTBALL_KEY=
# "direct" (chiave api-sports.io) oppure "rapidapi" (chiave RapidAPI)
API_FOOTBALL_MODE=direct
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# con RapidAPI usa invece: API_FOOTBALL_BASE_URL=https://api-football-v1.p.rapidapi.com/v3

# --- The Odds API (opzionale, seconda fonte di quote): https://the-odds-api.com --------
THE_ODDS_API_KEY=
THE_ODDS_API_REGIONS=eu,uk
THE_ODDS_API_MARKETS=h2h,totals
THE_ODDS_API_MIN_INTERVAL_S=120

# --- Scanner ---------------------------------------------------------------------------
# 30-60 secondi
POLL_INTERVAL_S=45
# id campionati API-Football separati da virgola (vuoto = tutti)
LEAGUE_WHITELIST=
MAX_FIXTURES_PER_CYCLE=120
# quote più vecchie non vengono mai mostrate
ODDS_MAX_AGE_S=90

# --- Filtri di valore --------------------------------------------------------------------
MIN_ODDS=1.75
# EV minimo DOPO il margine prudenziale
MIN_EV=0.03
# probabilità prudenziale - probabilità implicita
MIN_EDGE=0.03
# oltre questa distanza dal mercato = anomalia, esclusa
MAX_MODEL_MARKET_GAP=0.18

# --- Database ------------------------------------------------------------------------------
# default: SQLite in backend/data/scanner.db
# DATABASE_URL=postgresql+psycopg://utente:password@localhost:5432/scanner
