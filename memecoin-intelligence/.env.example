# =====================================================================
# Memecoin Intelligence - configuration (copy to .env, never commit .env)
# =====================================================================

# --- infrastructure (docker-compose) ---
POSTGRES_PASSWORD=change-me
# Public hostname for HTTPS, e.g. a free DuckDNS name: mionome.duckdns.org
DOMAIN=mionome.duckdns.org
# "web" starts the HTTPS dashboard (caddy); leave empty when there is no DOMAIN
COMPOSE_PROFILES=web

# --- general ---
MCI_ENV=prod
MCI_LOG_LEVEL=INFO
# Local dev uses SQLite; docker-compose overrides this with PostgreSQL
MCI_DATABASE_URL=sqlite:///./data/mci.db

# --- capital & risk ---
MCI_INITIAL_CAPITAL_SOL=2.0
# conservative | moderate | aggressive
MCI_RISK_PROFILE=moderate
MCI_ENABLED_STRATEGIES=A,B,C,D,E

# --- trading mode: PAPER is the default. Live requires ALL the gates in docs/SECURITY.md ---
MCI_TRADING_MODE=paper
MCI_LIVE_TRADING_ENABLED=false
MCI_LIVE_TRADING_CONFIRMATION=
MCI_LIVE_WALLET_KEYFILE=
MCI_LIVE_MAX_SPEND_PER_TRADE_SOL=0.1
MCI_LIVE_MAX_DAILY_SPEND_SOL=0.5
MCI_LIVE_MAX_PER_TOKEN_SOL=0.2

# --- dashboard ---
MCI_DASHBOARD_USERNAME=admin
MCI_DASHBOARD_PASSWORD=
# random 64 hex chars: openssl rand -hex 32
MCI_API_SECRET_KEY=

# --- telegram (create the bot with @BotFather) ---
# NEVER write real values in this file: it is public. On GitHub use Settings > Secrets > Actions;
# on a server put them in .env (which is git-ignored).
MCI_TELEGRAM_BOT_TOKEN=
MCI_TELEGRAM_CHAT_IDS=
MCI_TELEGRAM_MIN_SCORE_ALERT=75
# trades = only buy/sell messages (default); all = also signals, token alerts, daily report, notices
MCI_TELEGRAM_NOTIFY=trades
MCI_DAILY_REPORT_HOUR_UTC=21

# --- data sources (free endpoints; keys optional) ---
MCI_JUPITER_BASE_URL=https://lite-api.jup.ag
# optional free key from the Jupiter developer portal -> use https://api.jup.ag
MCI_JUPITER_API_KEY=
MCI_JUPITER_REQUESTS_PER_SECOND=0.5
# public RPC is heavily rate limited; a free Helius key is recommended:
# MCI_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
MCI_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
MCI_PUMPPORTAL_ENABLED=true

# optional: free Dune account -> historical universe for the backtest (mci import-universe)
MCI_DUNE_API_KEY=

# optional Reddit app (free, non-commercial personal use)
MCI_REDDIT_CLIENT_ID=
MCI_REDDIT_CLIENT_SECRET=

# --- execution cost model ---
MCI_PRIORITY_FEE_SOL=0.0001
MCI_JITO_TIP_SOL=0
MCI_DEFAULT_SLIPPAGE_BPS=300
